# Server-side only. Do not expose these through VITE_ variables.
FAL_KEY=
LINKUP_API_KEY=
TAVILY_API_KEY=
# Layout suggestions (POST /solve on the spatial service). Without a key, /solve reports
# the assistant as unavailable. Models default to claude-sonnet-5-5 (layout) and
# claude-haiku-5-5 (reading the typed request).
ANTHROPIC_API_KEY=
SPACESHIFT_LAYOUT_MODEL=
SPACESHIFT_INTERPRET_MODEL=
# Optional reconstruction settings. Leave them commented out for the defaults: an empty value
# replaces a default. See services/reconstruction/assets/README.md.
# FAL_VISION_ENDPOINT=fal-ai/any-llm/vision
# FAL_VISION_MODEL=google/gemini-2.5-flash
# FURNITURE_DATA_DIR=artifacts/furniture
# FURNITURE_DEMO_CACHE_DIR=services/reconstruction/assets/fixtures/demo_cache
# SCENE_DEMO_CACHE_DIR=services/reconstruction/room/fixtures/scene_cache
